# Copy to agent/.env and fill in. agent/.env is gitignored — never commit a key.
#
# OpenRouter API key. Get one at https://openrouter.ai/keys
# Without it the agents run fully deterministic (rule-based) and say so in
# /health and in every report, which is a supported mode, not a broken one.
OPENROUTER_API_KEY=

# Optional overrides of config/llm.yaml.
# OPENROUTER_MODEL=deepseek/deepseek-chat
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: set to 0/false to force deterministic mode even with a key present.
# AGENT_LLM_ENABLED=1
