# Copy to .env and fill in.

PORT=4000

# mock | real — see src/services/chainService.js. Start with mock; flip to real
# once `npx hardhat node` is running and the contract is deployed (see ../contracts).
CHAIN_MODE=mock

RPC_URL=http://127.0.0.1:8545

# Filled in automatically by contracts/scripts/deploy.js into
# backend/src/chain/deployment.json — or paste it here manually.
REGISTRY_CONTRACT_ADDRESS=

# Two of Hardhat's well-known default local test-account private keys (from
# `npx hardhat node` output). These are PUBLIC, well-known test keys — never
# use them anywhere with real funds. One represents the MSME owner (partyA,
# and the relayer that pays gas), one represents a counterparty who does
# happen to have a platform account (FULL_PLATFORM demo path only).
RELAYER_PRIVATE_KEY_A=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
RELAYER_PRIVATE_KEY_B=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# --- v3 identity ------------------------------------------------------------
# Origin the invite links point at. The Next.js dashboard runs on :3000; the
# legacy static app stays on :4000.
PUBLIC_BASE_URL=http://localhost:3000

# MSME-owner sign-in is plain email + password (scrypt-hashed, see
# services/passwords.js) — no third-party provider is configured. The
# /api/auth/demo endpoint is a labelled shortcut to a seeded demo owner.
SESSION_SECRET=
