# Dependencies
node_modules/

# Environment — never commit real secrets/config; .env.example is the template
.env
.env.local
.env.*.local

# Hardhat build output — regenerated by `npx hardhat compile`/`npx hardhat test`
contracts/artifacts/
contracts/cache/

# Per-deploy contract address — regenerated by contracts/scripts/deploy.js
# each time a teammate runs their own local chain. Never shared across machines.
backend/src/chain/deployment.json

# start.sh's local Hardhat node output
hardhat-node.log

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Local git worktrees for isolated feature work (superpowers:using-git-worktrees)
.worktrees/
